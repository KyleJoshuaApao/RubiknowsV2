{
  "extends": [
    "development"
  ],
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 149",
    "not chrome <= 150",
    "not edge <= 150",
    "not firefox <= 152",
    "not safari <= 26.5",
    "not samsung <= 30"
  ],
  "hints": {
    "meta-viewport": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "user-select"
        ]
      }
    ]
  }
}