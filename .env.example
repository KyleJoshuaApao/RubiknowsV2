APP_NAME=RubiKnows
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite. Production uses Supabase Postgres through the
# Session pooler, e.g. DB_HOST=aws-0-<region>.pooler.supabase.com,
# DB_PORT=5432, DB_USERNAME=postgres.<project-ref>, DB_SSLMODE=require.
DB_CONNECTION=sqlite
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Email. With RESEND_API_KEY set, all mail is sent through Resend's HTTPS API
# (SMTP ports are blocked on Render). Without it, mail is written to the log.
RESEND_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Uploads. With these set, uploads are stored in Supabase Storage and survive
# redeploys. Without them, they are stored in storage/app on the server.
# Create the keys in Supabase: Project Settings > Storage > S3 access keys.
SUPABASE_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=ap-northeast-2
SUPABASE_MEDIA_BUCKET=media
SUPABASE_DOCUMENTS_BUCKET=documents

VITE_APP_NAME="${APP_NAME}"

# Private path of the staff sign-in page (not linked anywhere on the site).
ADMIN_LOGIN_PATH=staff-sign-in

# Used by `php artisan db:seed` to create or update the super admin account.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
