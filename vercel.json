{
    "version": 2,
    "framework": null,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.6.2"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(build|css|gallery|images|js|storage)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt|LOGO\\.png|RK3\\.png|RK3-email\\.png|RK3-cropped\\.png)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:Ggm40JLaIAXXK5v+qMTGgusJ4i9xmXMcPaLEKxOKYoI=",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "s3",
        "VIEW_COMPILED_PATH": "/tmp/views",
        "APP_CONFIG_CACHE": "/tmp/storage/bootstrap/cache/config.php",
        "APP_ROUTES_CACHE": "/tmp/storage/bootstrap/cache/routes.php",
        "APP_EVENTS_CACHE": "/tmp/storage/bootstrap/cache/events.php",
        "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/cache/services.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/cache/packages.php"
    }
}