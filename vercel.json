{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.8.0",
            "config": {
                "buildCommand": "composer update && npm install --ignore-scripts && npm run build"
            }
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(build|css|gallery|images|js|storage)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt|LOGO\\.png|RK3\\.png|RK3-email\\.png|RK3-cropped\\.png)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:Ggm40JLaIAXXK5v+qMTGgusJ4i9xmXMcPaLEKxOKYoI=",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "s3",
        "VIEW_COMPILED_PATH": "/tmp/views"
    }
}