{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "build": {
        "env": {
            "BUILD_STEP": "1"
        }
    },
    "routes": [
        {
            "src": "/(build|css|gallery|images|js|storage)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt|LOGO\\.png|RK3\\.png|RK3-email\\.png|RK3-cropped\\.png)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "APP_KEY": "base64:Ggm40JLaIAXXK5v+qMTGgusJ4i9xmXMcPaLEKxOKYoI=",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "QUEUE_CONNECTION": "sync",
        "FILESYSTEM_DISK": "s3",
        "VIEW_COMPILED_PATH": "/tmp/views"
    }
}